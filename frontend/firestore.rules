rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // ===============================================================
    // Chats & Messages Collection (1:1 Realtime Chat)
    // Toàn bộ dữ liệu nghiệp vụ khác (Users, Appointments, Barbers, Reviews)
    // được xử lý tập trung qua ASP.NET Core Web API + SQL Server.
    // ===============================================================
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        resource.data.customerId == request.auth.uid ||
        resource.data.barberId == request.auth.uid
      );
      
      allow create, update: if isAuthenticated() && (
        request.auth.uid == request.resource.data.customerId ||
        request.auth.uid == request.resource.data.barberId ||
        request.auth.uid in request.resource.data.participants
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
