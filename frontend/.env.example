# ==============================================================================
# HairFit AI - Môi Trường Cấu Hình (Environment Variables Template)
# ==============================================================================
# Ứng dụng tích hợp công nghệ Tự Động Nhận Diện Nền Tảng (Zero-Config Auto-Discovery):
# - Chrome Web / Windows Desktop / macOS: Tự động kết nối http://localhost:5000
# - Máy ảo Android (Android Emulator): Tự động kết nối http://10.0.2.2:5000
# - Điện thoại thật cắm cáp USB: Tự động kết nối http://localhost:5000 (qua adb reverse)
# - Điện thoại thật chạy 4G/Wi-Fi từ xa: Tự động kết nối REMOTE_API_BASE_URL bên dưới
#
# BẠN KHÔNG CẦN SỬA FILE NÀY KHI ĐỔI THIẾT BỊ NỮA!
# ==============================================================================

# 1. Tên miền tĩnh cố định qua Ngrok Free (dành cho điện thoại kết nối 4G từ xa):
REMOTE_API_BASE_URL=https://clothing-similarly-delicacy.ngrok-free.dev

# 2. Chế độ kết nối:
# - 'auto' (Khuyên dùng): Tự động dò tìm và chọn URL nhanh nhất giữa Localhost, Emulator và Ngrok
# - Hoặc điền URL cụ thể nếu bạn muốn ÉP CỐ ĐỊNH 1 địa chỉ duy nhất.
API_BASE_URL=auto
